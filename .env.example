# AWS Bedrock / LLM Gateway (from NUS-ISS/AWS instructions — check Slack + team email)
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_MODEL=

# AWS account (for Lightsail deployment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# Turso (persistent state — checklist status, reminder history, audit trail)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: bring-your-own-key alternative
OPENROUTER_API_KEY=

# App config
APP_ENV=development

# Dashboard auth (Phase 3). The whole dashboard (all GET + POST routes) is
# gated with HTTP Basic auth. Log in with DASHBOARD_USER as the username and
# DASHBOARD_AUTH_TOKEN as the password. DASHBOARD_SECRET_KEY signs the session
# cookie used for CSRF protection on the approve/dismiss action — set it to a
# long random string.
DASHBOARD_USER=manager
DASHBOARD_AUTH_TOKEN=
DASHBOARD_SECRET_KEY=
