# AWS Bedrock / LLM Gateway (from NUS-ISS/AWS instructions on Slack)
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_MODEL=

# AWS account (for Lightsail deployment, once you get there)
