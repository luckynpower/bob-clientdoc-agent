# AWS Bedrock / LLM Gateway (from NUS-ISS/AWS instructions — check Slack + team email)
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_MODEL=

# AWS account (for Lightsail deployment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# Turso (persistent state — checklist status, reminder history, audit trail)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: bring-your-own-key alternative
OPENROUTER_API_KEY=

# App config
APP_ENV=development
